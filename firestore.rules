rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get the user's role
    function getRole() {
      // It's crucial that the 'roles' collection allows a user to read their own document
      // for this helper to work correctly.
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }

    // Public read access for web-facing collections
    // Assuming these are the collections shown on the public website
    match /audios/{document=**} {
      allow read: if true;
    }
    match /events/{document=**} { // Assuming 'events' is the collection for events
      allow read: if true;
    }
    match /media_photos/{document=**} { // Assuming 'media_photos' is the collection for multimedia gallery
      allow read: if true;
    }
    match /posts/{document=**} { // Assuming 'posts' is the collection for blog/reflections
      allow read: if true;
    }
    match /daily/{document=**} { // Assuming 'daily' is where daily verses are stored
      allow read: if true;
    }
    match /transmisiones/{document=**} { // Assuming 'transmisiones' is the collection for livestreams
      allow read: if true;
    }
    // Add any other public collections here. If 'estudios' is public, add it.
    match /estudios/{document=**} { // Assuming 'estudios' is for biblical studies
      allow read: if true;
    }
    match /verses/{document=**} { // Assuming 'verses' might be for the bible viewer
      allow read: if true;
    }
    match /bible_sample/{document=**} { // Assuming 'bible_sample' is for bible content
      allow read: if true;
    }


    // Rules for the 'roles' collection
    match /roles/{userId} {
      // Authenticated users can read their own role document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Only administrators can create, update, or delete role documents
      // This implicitly means the 'admin' role needs to be manually set initially
      allow write: if isAuthenticated() && getRole() == 'admin';
    }

    // Admin-only write/edit/delete access for other collections (e.g., content management)
    match /{collection}/{document=**} {
      // Public read for all collections by default if not specified above
      allow read: if true;
      allow write: if isAuthenticated() && getRole() == 'admin';
    }

    // Override public read for collections that need restricted read access (e.g., admin-only data)
    // Example: if you had an 'adminLogs' collection
    // match /adminLogs/{document=**} {
    //   allow read, write: if isAuthenticated() && getRole() == 'admin';
    // }
  }
}
