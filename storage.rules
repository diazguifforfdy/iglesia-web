rules_version = '2';




service firebase.storage {
  match /b/{bucket}/o {

    // Regla general: por defecto, nadie puede leer o escribir.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Permite la lectura pública de archivos en las carpetas 'public', 'audios_alabanza' y 'media_photos'.
    // La escritura (subida) solo está permitida para usuarios autenticados (admins/editores).
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Permite escribir a cualquier usuario logueado
    }
    match /audios_alabanza/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Permite escribir a cualquier usuario logueado
    }
    match /media_photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Permite escribir a cualquier usuario logueado
    }
    match /albums/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Permite escribir a cualquier usuario logueado
    }
  }
}